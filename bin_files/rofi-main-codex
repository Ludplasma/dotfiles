#!/bin/bash

CHOSEN=$(rofi -dmenu -p "CODE:")

case ${CHOSEN} in
"a")
  rofi -show drun -show-icons
  ;;
"p")
  rofi-powermenu
  ;;
"pd")
  systemctl poweroff
  ;;

"w")
  rofi-wifi-menu
  ;;
"wa")
  notify-send "Wifi radio turned on"
  nmcli radio wifi on
  ;;
"wd")
  notify-send "Wifi radio turned off"
  nmcli radio wifi off
  ;;
"nmr")
  notify-send "Restarting NetworkManager"
  sudo systemctl restart NetworkManager
  ;;

"l")
  hyprlock
  ;;
"c")
  kitty -e nvim
  ;;
"co")
  rofi-set-select-config
  ;;
"web")
  cd ~/projects/hyprlinkwindow/ && npm start
  ;;
"webn")
  nativeweblauncher
  ;;
"wal")
  rofi-set-wal
  ;;
"emo")
  rofi -show emoji --action clipboard
  ;;
"cal")
  rofi -show calc -no-show-match -no-sort
  ;;
"tw")
  toggle-waybar
  ;;
"ro")
  python ~/Games/RobloxAccountManagerLinux/main.py
  ;;
"imt")
  grim -g "$(slurp)" /tmp/ocr.png
  tesseract /tmp/ocr.png stdout | wl-copy
  notify-send "OCR copied to clipboard"
  ;;
"sysre")
  kitty -e btop -u 200 -p 2
  ;;
"zap")
  flatpak run com.rtosta.zapzap
  ;;
"steam")
  flatpak run com.valvesoftware.Steam
  ;;
"gw2")
  xdg-open "steam://rungameid/1284210/"
  ;;

"ai")
  ailauncher -m chat
  ;;
"aic")
  ailauncher -m command
  ;;
"aiq")
  ailauncher -m singleword
  ;;
"aimt")
  ai-ocr-launcher
  ;;
"aichat")
  profile_dir="$HOME/.local/share/webapps/openrouter"
  mkdir -p "$profile_dir"
  "chromium" \
    --ozone-platform=wayland \
    --enable-features=UseOzonePlatform \
    --app="https://openrouter.ai/chat" \
    --user-data-dir="$profile_dir" \
    >/dev/null 2>&1 &
  ;;

"cl")
  cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy
  ;;
"cld")
  cliphist list | rofi -dmenu -p "Clipboard" | cliphist delete
  ;;
"clw")
  cliphist wipe
  ;;

"gamo")
  game-net-optimize
  ;;
"code")
  code
  ;;
"note")
  note="$HOME/notes/quick.md"
  kitty -e nvim "$note"
  ;;
"update")
  kitty -e sudo pacman -Syu
  kitty -e flatpak update#!/usr/bin/env bash

  if paru -Qua | grep -q '^paru '; then
    echo "paru update available"
    paru-update
  else
    echo "paru is current"
  fi
  ;;

"firea")
  kitty -e sudo systemctl stop firewalld
  ;;
"fired")
  kitty -e sudo systemctl start firewalld
  ;;

"mikb")
  bash -c ~/Appps/WinBox_Linux/WinBox
  ;;
"mikc")
  kitty -e sudo systemctl stop firewalld
  kitty -e sudo ip addr add 192.168.88.2/24 dev enp0s20f0u2
  ;;
"mikd")
  kitty -e sudo systemctl start firewalld
  kitty -e sudo ip addr delete 192.168.88.2/24 dev enp0s20f0u2
  ;;

"tome")
  cd ~/Games/tome && ~/Games/tome/t-engine
  ;;

"tor")
  sudo systemctl start tor
  ;;
"tord")
  sudo systemctl stop tor
  ;;
"torb")
  tor-browser
  ;;
"tort")
  torsocks kitty --class scratchpad
  ;;

"ippubtor")
  torsocks echo -e $(curl -s https://ipinfo.io/ip) | wl-copy
  ;;
"ippub")
  echo -e $(curl -s https://ipinfo.io/ip) | wl-copy
  ;;
"iplan")
  LANIP=$(ip addr show | grep -w inet | grep -v 127.0.0.1 | awk '{print $2}' | cut -d'/' -f1 | head -n1)
  notify-send "LAN IP: $LANIP"
  ehco "$LANIP" | wl-copy
  ;;

"cpup")
  powerprofilesctl set performance
  notify-send "Performance mode enabled"
  ;;
"cpub")
  powerprofilesctl set balanced
  notify-send "Balanced mode enabled"
  ;;
"cpus")
  powerprofilesctl set power-saver
  notify-send "Power saver enabled"
  ;;
"cpro")
  PROJECT_DIR="$HOME/projects"
  project=$(basename -a ~/projects/* | rofi -dmenu)
  selected="$PROJECT_DIR/$project"
  kitty --directory "$selected" nvim .
  ;;
esac
