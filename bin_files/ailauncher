#!/bin/bash
source ~/.env
API_KEY="$OPENROUTER_API_KEY"
MODEL="openai/gpt-4.1-mini"

prompt=$(rofi -dmenu -p "Ask AI")

[ -z "$prompt" ] && exit

response=$(curl -s https://openrouter.ai/api/v1/chat/completions \
  -H "Authorization: Bearer $API_KEY" \
  -H "Content-Type: application/json" \
  -d "{
    \"model\": \"$MODEL\",
    \"messages\": [
      {
        \"role\": \"system\",
        \"content\": \"Do not use new lines in responses, Keep responses short and informative\"
      },
      {
        \"role\": \"user\",
        \"content\": \"$prompt\"
      }
    ]
  }" | jq -r '.choices[0].message.content')

[ -z "$response" ] && {
  notify-send "AI request failed"
  exit 1
}

selected=$(printf "%s" "$response" | rofi \
  -dmenu \
  -i \
  -p "AI Response (Enter = Copy)" \
  -theme-str 'window {width: 70%; height: 60%;}')

[ -n "$selected" ] && {
  printf "%s" "$response" | wl-copy
  notify-send "AI response copied to clipboard"
}
