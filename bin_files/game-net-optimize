#!/usr/bin/env bash
set -e

echo "[+] Applying Linux gaming network optimizations..."

# Detect active NetworkManager connection
CON_NAME=$(nmcli -t -f NAME,DEVICE connection show --active | head -n1 | cut -d: -f1)

# Detect WiFi interface
WIFI_IF=$(nmcli -t -f DEVICE,TYPE device status | grep ':wifi' | cut -d: -f1)

# Disable WiFi power saving via NetworkManager (correct method)
if [[ -n "$WIFI_IF" && -n "$CON_NAME" ]]; then
  echo "[+] Disabling WiFi power saving on $WIFI_IF"
  nmcli con modify "$CON_NAME" 802-11-wireless.powersave 2
fi

# Enable BBR congestion control
echo "[+] Enabling BBR congestion control"
echo "net.ipv4.tcp_congestion_control=bbr" | sudo tee -a /etc/sysctl.conf
sudo sysctl -p

# Force stable DNS using NetworkManager
if [[ -n "$CON_NAME" ]]; then
  echo "[+] Forcing stable DNS for connection: $CON_NAME"
  nmcli con modify "$CON_NAME" ipv4.ignore-auto-dns yes
  nmcli con modify "$CON_NAME" ipv4.dns "1.1.1.1 8.8.8.8"
  nmcli con modify "$CON_NAME" ipv6.ignore-auto-dns yes
  nmcli con modify "$CON_NAME" ipv6.dns "2606:4700:4700::1111 2001:4860:4860::8888"
  nmcli con down "$CON_NAME" && nmcli con up "$CON_NAME"
fi

echo "[✓] Network optimization complete."
